---
import AuditBookingSection from "../components/AuditBookingSection.astro";
import ClientReviews from "../components/ClientReviews.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { absoluteUrl, defaultSocialImage, standardPageSchema } from "../lib/site";
import { productScreenshotForPath } from "../lib/productScreenshots";
import "../styles/landing.css";

const title = "Book a 15-Minute Consultation | EMC2Ops";
const description = "Book a 15-minute EMC2Ops consultation to outline a custom automation build around your property management processes, software, and desired result.";
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/book-demo/")}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="EMC2Ops property management automation implementation for your existing processes and software."
  schema={standardPageSchema({ path: "/book-demo/", name: "Book an EMC2Ops consultation", description, type: "ContactPage" })}
  author="EMC2Ops"
>
  <SiteHeader variant="blog" />

  <main>
    <section class="booking-page-hero">
      <div class="wrap">
        <h1>Tell us what you want to automate.</h1>
        <p class="lead">Bring your process, software, and desired result. In a 15-minute consultation, we’ll outline a plan to build your solution and confirm the next steps.</p>
      </div>
    </section>

    <AuditBookingSection />

    <section class="product-proof-section">
      <div class="wrap">
        <ProductScreenshot screenshot={productScreenshotForPath("/book-demo/")} />
      </div>
    </section>

    <ClientReviews />


  </main>

  <SiteFooter variant="blog" />
</SiteLayout>
