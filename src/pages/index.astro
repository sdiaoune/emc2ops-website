---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import ClientReviews from "../components/ClientReviews.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { homepageBuyerFaqs, homepageSetupFaqs } from "../lib/homepageFaq";
import { homepageMetadata } from "../lib/homepageContent";
import { launchApprovalChecks } from "../lib/homepageImplementation";
import { productScreenshotForPath } from "../lib/productScreenshots";
import { absoluteUrl, defaultSocialImage, homeSchema } from "../lib/site";
import "../styles/homepage.css";

const productScreenshot = productScreenshotForPath("/");
const recoverySteps = [
  ["Missed call", "Your phone provider records an unanswered leasing call and starts the response process."],
  ["Text reply", "With required messaging consent in place, the caller receives a branded text and an approved question."],
  ["Renter details", "Approved questions capture property interest, move date, budget, and tour preferences."],
  ["Staff assignment", "Your chosen staff member receives the request. A person handles sensitive questions and uncertain answers."],
  ["Outcome reviewed", "Your outcome report separates text sends, two-way replies, staff handoffs, and confirmed tours."],
];
---
<SiteLayout
  pageClass="homepage"
  title={homepageMetadata.title}
  description={homepageMetadata.description}
  canonical={absoluteUrl("/")}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="PM Ops dashboard illustrating custom property management automation."
  schema={homeSchema()}
  author="EMC2Ops"
>
  <SiteHeader variant="landing" />
  <main id="main-content">
    <section class="hero" aria-labelledby="home-heading">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Missed-call recovery · Residential leasing</p>
          <h1 id="home-heading">Turn missed leasing calls into renter conversations.</h1>
          <p class="lead">For small property management teams whose unanswered calls go without follow-up. Send a consent-appropriate text, capture what the renter needs, and give your staff a clear next step.</p>
          <ul class="hero-takeaways" aria-label="Your missed-call pilot">
            <li>One leasing number.</li><li>Your existing scheduler or staff handoff.</li><li>Replies and outcomes you can review.</li>
          </ul>
          <div class="hero-actions">
            <a href="/book-demo/#workflow=missed-call-recovery&amp;source=homepage" class="btn btn-primary">Review my missed-call pilot</a>
            <a href="#overview" class="demo-link">See the recovery workflow <span aria-hidden="true">↓</span></a>
          </div>
          <p class="consultation-note">A 15-minute scope review. Bring your leasing number and current follow-up process.</p>
        </div>
        <figure class="recovery-example" aria-labelledby="recovery-example-heading">
          <div class="recovery-example-head"><span class="example-dot" aria-hidden="true"></span><h2 id="recovery-example-heading">One call. A clear next step.</h2><span class="example-badge">Illustrative</span></div>
          <ol class="recovery-timeline" aria-label="Illustrative missed-call recovery">
            <li><span class="recovery-number">01</span><div><h3>Leasing call goes unanswered</h3><p>Your phone provider sends a missed-call event.</p></div></li>
            <li><span class="recovery-number">02</span><div><h3>Permission checked. Text sent.</h3><p class="recovery-message">“Thanks for calling Maple Row Apartments. What are you looking for in your next rental? Reply STOP to opt out.”</p></div></li>
            <li><span class="recovery-number">03</span><div><h3>The renter replies</h3><p class="recovery-message renter-message">“A two-bedroom. Hoping to move November 1.”</p></div></li>
            <li><span class="recovery-number">04</span><div><h3>Staff receive the inquiry</h3><dl class="recovery-record"><div><dt>Interest</dt><dd>Two-bedroom · November 1</dd></div><div><dt>Next action</dt><dd>Leasing staff confirm tour options</dd></div></dl></div></li>
          </ol>
          <figcaption>Fictional renter data. Texts require the approved permission check; availability and tours stay with your team.</figcaption>
        </figure>
      </div>
    </section>

    <section id="missed-call-pilot" class="home-section home-section-muted pilot-offer" aria-labelledby="pilot-heading">
      <span id="offer" class="anchor-alias"></span><span id="pricing" class="anchor-alias"></span>
      <div id="services" class="wrap offer-layout">
        <div class="section-intro">
          <p class="eyebrow">The missed-call leasing pilot</p>
          <h2 id="pilot-heading">One number. One recovery workflow.</h2>
          <p>A fixed starting scope for small residential property managers with a gap in missed-call coverage. EMC2Ops configures and tests the workflow around the tools and people you already use.</p>
          <a class="text-link" href="/services/missed-call-recovery/">Explore missed-call text-back <span aria-hidden="true">→</span></a>
        </div>
        <ul class="offer-features" role="list" aria-label="Included in the pilot">
          <li><span class="offer-number">01 / Connect</span><h3>One leasing phone number</h3><p>Check your provider’s missed-call event and route eligible inquiries into the recovery workflow.</p></li>
          <li><span class="offer-number">02 / Follow up</span><h3>Approved text and stop rules</h3><p>Consent-appropriate follow-up with your wording. Opt-outs, duplicates, and staff takeover stop further automated messages.</p></li>
          <li><span class="offer-number">03 / Capture</span><h3>Basic renter details</h3><p>Collect property interest, move date, budget, and tour preference. Unanswered or sensitive questions reach a person.</p></li>
          <li><span class="offer-number">04 / Hand off</span><h3>A next step and outcome report</h3><p>Use your existing scheduling link or assign staff a summary. Review eligible calls, texts, two-way replies, and confirmed tours separately.</p></li>
        </ul>
        <div class="pilot-fit"><p><strong>A good fit:</strong> your team misses leasing calls and has someone ready to handle replies.</p><p><strong>Already covered?</strong> If your current provider handles missed calls effectively, this pilot may add little value.</p></div>
        <p class="offer-scope"><strong>Scope and cost:</strong> Maintenance intake, live AI call answering, and custom CRM development are outside this pilot. Pricing is quote-based; the written proposal confirms provider access, messaging requirements, usage costs, and support before you approve a launch.</p>
      </div>
    </section>

    <section id="overview" class="home-section" aria-labelledby="workflow-heading">
      <span id="pain" class="anchor-alias"></span>
      <div class="wrap">
        <div class="section-intro">
          <h2 id="workflow-heading">See a missed-call inquiry reach your team</h2>
          <p>Your phone provider reports the missed call; the configured process checks permission and sends the first text. Staff receive a summary and the next task.</p>
          <a class="text-link" href="/services/missed-call-recovery/">See the pilot scope and fit <span aria-hidden="true">→</span></a>
        </div>
        <ol class="workflow-steps" role="list" aria-label="Five-step missed-call recovery process">
          {recoverySteps.map(([title, body]) => <li><h3>{title}</h3><p>{body}</p></li>)}
        </ol>
        <p class="process-terms">SMS means short message service: a text message. Approved questions gather basic inquiry details. Staff confirm availability, tours, and leasing decisions.</p>
        <div id="demo" class="demo-showcase">
          <figure class="demo-video">
            <video controls playsinline preload="metadata" poster="/social-assets/emc2ops-missed-call-recovery-demo-landing-poster.jpg" aria-label="EMC2Ops missed-call recovery product demonstration">
              <source src="/social-assets/emc2ops-missed-call-recovery-demo-landing.mp4" type="video/mp4" />
              Your browser does not support embedded video. <a href="/social-assets/emc2ops-missed-call-recovery-demo-landing.mp4">Download the demonstration.</a>
            </video>
            <figcaption>See the workflow in action. This demonstration uses fictional renter data.</figcaption>
          </figure>
          <div class="product-hero-media">
            <ProductScreenshot screenshot={productScreenshot} variant="hero" useDesktopOnMobile />
            <p class="example-note">Existing product demonstration with fictional data. The pilot uses the agreed inquiry fields and staff handoff; this interface is not a promise of a custom CRM.</p>
          </div>
        </div>
        <details id="proof" class="measurement-block example-details"><summary>Measurement definitions for this example</summary>
          <h3>How will you measure the result?</h3>
          <p>Review response time, two-way replies, and record completeness for the same date range. Keep sent messages, renter replies, confirmed tours, and signed leases separate.</p>
          <dl class="measurement-list">
            <div><dt>Response time:</dt>{" "}<dd>Time from an eligible missed-call event until the messaging provider accepts the text. Report acceptance and delivery status separately.</dd></div>
            <div><dt>Recovered inquiry:</dt>{" "}<dd>One unique missed-call inquiry where the renter replies to the text. Sending a text without a reply does not count.</dd></div>
            <div><dt>Record completeness:</dt>{" "}<dd>The percentage of reviewed records with all required renter details, a responsible staff member, and a next action.</dd></div>
          </dl>
          <p id="message-status" class="source-note"><strong>Acceptance is not delivery.</strong> The sending service has received the request; a delivery receipt reports a later carrier or handset status. Neither confirms that the renter read the text. See <a href="https://www.twilio.com/docs/messaging/api/message-resource#message-status-values">Twilio’s message-status definitions</a>.</p>
          <div class="measurement-example">
            <h3>How would a recovery rate be calculated?</h3>
            <p>Divide unique inquiries with a two-way reply by unique missed-call inquiries in the same reporting period. Count repeat calls about the same inquiry only once.</p>
            <p><strong>Fictional calculation, not client results:</strong> 8 two-way replies from 20 unique missed-call inquiries = 40% recovery. This example is not a forecast or target.</p>
          </div>
          <a href="/resources/missed-call-recovery-roi-calculator/" class="text-link">Estimate results using your own call data <span aria-hidden="true">→</span></a>
        </details>
        <aside id="messaging-safeguards" class="messaging-safeguards" aria-labelledby="messaging-heading"><details class="example-details"><summary id="messaging-heading">Messaging safeguards for voice and text workflows</summary>
          <h3>What must be in place before sending texts?</h3>
          <p>Your business approves permission to text, how people stop messages, and the number’s registration requirements. EMC2Ops configures and tests those instructions before launch.</p>
          <dl class="safeguard-terms">
            <div><dt>Consent:</dt>{" "}<dd>The person agrees to messages from your business for the stated purpose. A missed call is not blanket permission for marketing texts.</dd></div>
            <div><dt>Opt-out:</dt>{" "}<dd>A request such as STOP ends further automated follow-up. The process records the request so it is not restarted by another step.</dd></div>
            <div><dt>Carrier registration:</dt>{" "}<dd>Business and message details submitted for review through the messaging provider. Requirements vary with the number type and destination.</dd></div>
          </dl>
          <p class="source-note">Reference the <a href="https://www.twilio.com/en-us/legal/messaging-policy">Twilio messaging policy</a>, its <a href="https://www.twilio.com/docs/messaging/compliance/a2p-10dlc/collect-business-info">US business-registration requirements</a>, and <a href="https://consumercomplaints.fcc.gov/hc/en-us/articles/115002234203-Unwanted-Calls-Texts-Phone">Federal Communications Commission guidance</a>. Configuration is not legal or carrier approval.</p>
        </details></aside>
      </div>
    </section>

    <section id="implementation" class="home-section home-section-muted" aria-labelledby="implementation-heading">
      <span id="evidence" class="anchor-alias"></span>
      <div class="wrap">
        <div class="section-intro"><p class="eyebrow">Before the pilot starts</p><h2 id="implementation-heading">Check the fit. Test the handoff.</h2><p>Confirm your missed-call gap, provider access, approved messages, and the staff member who owns each reply. Your team reviews the test results before launch.</p></div>
        <div class="pilot-launch-grid">
          <div><h3>Your team brings</h3><ul><li>One leasing number and its provider.</li><li>Approved property facts and messaging permissions.</li><li>An existing scheduler or named staff contact.</li></ul></div>
          <div><h3>EMC2Ops tests</h3><ul>{launchApprovalChecks.map((item) => <li>{item}</li>)}</ul></div>
        </div>
        <div id="integrations" class="pilot-connection"><h3>Use the tools you already have</h3><p>Direct access is checked during scoping. A staff summary or existing scheduling link can carry the inquiry when a direct connection is unavailable. <a href="/integrations/">Review connection options</a>.</p></div>
        <details id="language-testing" class="example-details"><summary>Timing, languages, and launch requirements</summary><p>The written scope sets the launch window after access and messaging requirements are checked. English is the default; another language requires property-specific testing and your approval.</p><a class="text-link checklist-download" href="/resources/emc2ops-launch-checklist.txt" download="emc2ops-launch-checklist.txt">Download the launch checklist (text)</a></details>
      </div>
    </section>

    <ClientReviews variant="homepage" />

    <aside class="customer-results" aria-label="Customer operating scale">
      <dl class="wrap customer-results-list">
        <div class="customer-result"><dt>3,000+</dt> <dd>Units served <span>Across 200+ properties</span></dd></div>
        <div class="customer-result"><dt>300+</dt> <dd>Security deposits processed per month</dd></div>
        <div class="customer-result"><dt>500+</dt> <dd>Work order tickets processed per month</dd></div>
      </dl>
      <div class="wrap scale-caption">Operating-scale figures, not measured increases in conversions or time saved.</div>
    </aside>

    <section id="use-cases" class="home-section home-section-muted" aria-labelledby="examples-heading">
      <div class="wrap">
        <div class="section-intro"><h2 id="examples-heading">Explore more property management workflows</h2><p>These are separate services, beyond the missed-call pilot. Existing guides cover leasing, records, maintenance, and security deposits.</p></div>
        <div class="table-scroll" role="region" aria-label="Property management automation examples" tabindex="0">
          <table class="comparison-table workflow-table">
            <caption>Five workflow areas, built around your processes</caption>
            <thead><tr><th scope="col">Workflow</th><th scope="col">Example</th><th scope="col">Explore</th></tr></thead>
            <tbody>
              <tr><th scope="row">Leasing and follow-up</th><td>Inquiry to qualified renter, confirmed showing, and assigned next task.</td><td><a href="/use-cases/lead-to-lease-automation/">Explore leasing automation</a></td></tr>
              <tr><th scope="row">Maintenance and vendors</th><td>Request intake, staff review, vendor coordination, and completion records.</td><td><a href="/use-cases/maintenance-request-to-completion/">Explore maintenance workflows</a></td></tr>
              <tr><th scope="row">Resident and owner communication</th><td>Approved updates, reminders, and requests routed to the responsible person.</td><td><a href="/use-cases/resident-owner-vendor-communication-automation/">Explore communication workflows</a></td></tr>
              <tr><th scope="row">CRM and records</th><td>Clean customer relationship management records with reliable handoffs and next actions.</td><td><a href="/use-cases/real-estate-crm-follow-up-mess/">Explore record automation</a></td></tr>
              <tr><th scope="row">Security deposits</th><td>Evidence collection, charge review, approved disposition, and a recorded handoff.</td><td><a href="/use-cases/security-deposit-automation/">Explore deposit workflows</a></td></tr>
            </tbody>
          </table>
        </div>
        <nav class="service-paths" aria-label="Explore all automation options"><a href="/services/">See what we build</a><a href="/use-cases/">See how workflows work</a><a href="/services/security-deposit-automation/">Security deposit implementation</a></nav>
      </div>
    </section>



    <section id="faq" class="home-section home-section-muted" aria-labelledby="faq-heading">
      <div class="wrap faq-layout">
        <div class="section-intro"><h2 id="faq-heading">Questions before you get started.</h2><p>Start with these answers about fit, boundaries, and setup. Each workflow is scoped around your team’s tools and the decisions that should stay with people.</p><a class="text-link" href="/compare/">Compare your options <span aria-hidden="true">→</span></a></div>
        <div>
          <div class="faq-grid buyer-faq-grid">{homepageBuyerFaqs.map((faq, index) => <details class="faq-item" open={index === 0}><summary><span>{faq.question}</span></summary><div class="faq-answer"><p>{faq.answer}</p>{faq.cta && <a href={faq.cta.href} class="text-link" data-faq-cta>{faq.cta.label} <span aria-hidden="true">→</span></a>}</div></details>)}</div>
          <div class="faq-secondary"><h3>More setup questions</h3><div class="faq-grid setup-faq-grid">{homepageSetupFaqs.map((faq) => <details class="faq-item compact"><summary><span>{faq.question}</span></summary><div class="faq-answer"><p>{faq.answer}</p>{faq.cta && <a href={faq.cta.href} class="text-link" data-faq-cta>{faq.cta.label} <span aria-hidden="true">→</span></a>}</div></details>)}</div></div>
        </div>
      </div>
    </section>

    <section id="contact" class="home-section closing-section" aria-labelledby="closing-heading">
      <span id="landing-pages" class="anchor-alias"></span>
      <div class="wrap closing-content"><div><h2 id="closing-heading">Give your next missed call a next step.</h2><p>Review one leasing number, your current coverage, and the handoff your team needs.</p><ul class="closing-recap"><li>A defined pilot scope and quote before launch.</li><li>Your staff own availability, tours, and leasing decisions.</li></ul></div><a href="/book-demo/#workflow=missed-call-recovery&amp;source=homepage" class="btn btn-primary">Review my missed-call pilot</a></div>
    </section>

    <section id="newsletter" class="home-section newsletter-section" aria-labelledby="newsletter-heading">
      <div class="wrap newsletter-layout">
        <div><h2 id="newsletter-heading">Get property management automation ideas</h2><p>Occasional practical notes on leasing intake, follow-up, and operational workflows. Unsubscribe whenever they are no longer useful.</p></div>
        <form id="newsletter-form">
          <label for="newsletter-email">Email address</label>
          <div class="newsletter-fields"><input id="newsletter-email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" /><button class="btn btn-primary" type="submit">Subscribe</button></div>
          <input name="source" type="hidden" value="website-newsletter" />
          <label hidden>Leave this empty<input name="websiteConfirm" tabindex="-1" autocomplete="off" /></label>
          <p id="newsletter-form-status" class="form-status" role="status" aria-live="polite"></p>
          <noscript><p>JavaScript is needed to submit this form. All website information remains available without it.</p></noscript>
        </form>
      </div>
    </section>
  </main>
  <SiteFooter variant="landing" />
  <script is:inline>
    const newsletterForm = document.querySelector("#newsletter-form");
    const newsletterFormStatus = document.querySelector("#newsletter-form-status");
    newsletterForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = newsletterForm.querySelector("button[type='submit']");
      const payload = Object.fromEntries(new FormData(newsletterForm).entries());
      payload.pageUrl = window.location.href;
      newsletterFormStatus.textContent = "Subscribing...";
      newsletterFormStatus.className = "form-status";
      submitButton.disabled = true;
      try {
        const response = await fetch("/api/newsletter-subscribe", {
          method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload)
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || "We could not subscribe that email.");
        newsletterForm.reset();
        newsletterFormStatus.textContent = "Subscribed. Check your inbox for future notes.";
        newsletterFormStatus.className = "form-status success";
      } catch (error) {
        newsletterFormStatus.textContent = error.message || "Something went wrong. Please try again in a moment.";
        newsletterFormStatus.className = "form-status error";
      } finally { submitButton.disabled = false; }
    });
  </script>
</SiteLayout>
