---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { absoluteUrl, blogIndexSchema, byOrder, defaultSocialImage } from "../../lib/site";
import "../../styles/blog.css";

const posts = byOrder(await getCollection("blog"));
const featuredSlugs = ["apartment-call-tracking", "apartment-lead-tracking", "automate-property-management-lead-follow-up", "property-management-make-ready-automation", "property-management-security-deposit-return-automation", "ai-leasing-assistant"];
const featuredPosts = featuredSlugs.flatMap((slug) => posts.filter((post) => post.data.slug === slug));
const remainingPosts = posts.filter((post) => !featuredSlugs.includes(post.data.slug));
const displayedPosts = [...featuredPosts, ...remainingPosts];
const pillars = [...new Set(posts.map((post) => post.data.pillar))];
const title = "Property Management Automation Blog | EMC2Ops";
const description =
  "Practical guides for property managers on leasing capture, follow-up, unit turns, deposit review, owner reporting, and choosing the first automation.";
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/blog/")}
  type="website"
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="Property Management Automation Blog | EMC2Ops social preview from EMC2Ops."
  schema={blogIndexSchema(displayedPosts)}
  pageClass="blog-index"
>
  <SiteHeader />
  <main>
    <section class="blog-hero">
      <div class="wrap">
        <p class="eyebrow">Property management automation guides</p>
        <h1>Learn what to automate before you buy an AI front desk.</h1>
        <p class="dek">
          Practical guides on missed-call recovery, leasing follow-up, maintenance intake, owner
          updates, vendor routing, CRM workflow automation, and SMS compliance for property
          management teams.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/book-demo/">Book a 15-minute consultation</a>
          <a class="btn btn-secondary" href="#posts">Browse articles</a>
        </div>
      </div>
    </section>

    <section class="wrap programmatic">
      <h2>Use the guides to pick the first workflow.</h2>
      <p>
        Start with the task your team repeats most: capturing leasing inquiries, following up after
        tours, preparing a unit, or assembling evidence for review. The featured guides provide
        checklists, examples, required records, and staff handoffs you can discuss with your team.
        For choosing between workflows, use the <a href="/use-cases/how-to-automate-property-management/">automation prioritization guide</a>.
      </p>
    </section>

    <section id="featured-guides" class="wrap blog-list" aria-labelledby="featured-heading">
      <h2 id="featured-heading">Start with these implementation guides</h2>
      <p>Evergreen guides for the decisions and handoffs property teams manage every week.</p>
      <div class="post-grid">{featuredPosts.map((post) => <BlogCard post={post} />)}</div>
    </section>

    <section class="wrap blog-newsletter">
      <NewsletterSignup
        title="Get new automation guides when they publish."
        description="A daily send only when EMC2Ops publishes new property management automation guides."
        source="blog-index-newsletter"
      />
    </section>

    <section id="posts" class="wrap blog-list">
      {
        pillars.map((pillar) => (
          <div class="pillar">
            <h2>{pillar}</h2>
            <div class="post-grid">
              {remainingPosts
                .filter((post) => post.data.pillar === pillar)
                .map((post) => <BlogCard post={post} />)}
            </div>
          </div>
        ))
      }
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
