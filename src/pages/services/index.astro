---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ClientReviews from "../../components/ClientReviews.astro";
import ProductScreenshot from "../../components/ProductScreenshot.astro";
import { auditHref } from "../../lib/conversion";
import { absoluteUrl, defaultSocialImage, standardPageSchema } from "../../lib/site";
import { servicePages, serviceUrl } from "../../lib/services";
import { productScreenshotForPath } from "../../lib/productScreenshots";
import "../../styles/service.css";

const deliverables: Record<string, string> = {
  "custom-property-management-automation": "A documented workflow, supported integrations, acceptance tests, operating instructions, and an agreed maintenance scope.",
  "security-deposit-automation": "Case and evidence mapping, versioned approvals, disposition preparation, and separate payment-status handoffs.",
  "missed-call-recovery": "Call-event capture, approved response rules, staff routing, delivery checks, and CRM next actions.",
  "leasing-follow-up": "Stage-specific sequences, suppression and takeover checks, message templates, and saved follow-up outcomes.",
  "maintenance-intake-automation": "Required intake fields, property matching, evidence collection, urgency routing, and a review-ready request.",
  "crm-workflow-automation": "Field and stage definitions, duplicate handling, owned tasks, supported writebacks, and validation cases.",
  "owner-update-automation": "Verified source mappings, report drafts, approval queues, and delivery records tied to the property.",
  "vendor-dispatch-automation": "Approved work briefs, vendor acceptance, scheduling handoffs, and completion or delay tracking.",
  "ai-front-desk-property-management": "Voice and SMS context capture, an owned human handoff, CRM updates, and cross-channel stop rules."
};

const title = "Property Management Automation Services | EMC2Ops";
const description =
  "Custom property management automation services: workflow design, integrations, leasing, maintenance, communications, CRM, security deposits, and support.";
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/services/")}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="EMC2Ops property management automation service workflow."
  schema={standardPageSchema({ path: "/services/", name: "Property management automation services", description, type: "CollectionPage" })}
  pageClass="service-page"
>
  <SiteHeader />
  <main>
    <section class="service-hero">
      <div class="wrap">
        <p class="eyebrow">Services</p>
        <h1>Custom automation services. Built for your workflow.</h1>
        <p class="dek">
          Services explain what we build and maintain. Bring your process and software; we design, integrate, test, and support the automation. The examples below are starting points, not a fixed menu.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/book-demo/#workflow=custom-property-management-automation&source=services-index">Book a 15-minute consultation</a>
          <a class="btn btn-secondary" href="#choose">Explore services</a>
        </div>
      </div>
    </section>

    <section class="product-proof-section">
      <div class="wrap">
        <ProductScreenshot screenshot={productScreenshotForPath("/services/")} />
      </div>
    </section>

    <ClientReviews />

    <section id="choose" class="wrap detail-section">
      <p class="eyebrow">Decision guide</p>
      <h2>Match your workflow to an implementation</h2>
      <p>Choose the recurring problem first, then review the deliverables and access requirements on its service page. A consultation confirms your scope, acceptance criteria, and the staff decisions the workflow must preserve.</p>
      <div class="decision-grid">
        <a href="/services/ai-front-desk-property-management/"><strong>Calls and texts need a shared intake and handoff</strong><span>Capture the conversation context, route the next action, and verify the CRM record across voice and SMS.</span></a>
        <a href="/services/custom-property-management-automation/"><strong>You have a custom workflow in mind</strong><span>We design, build, integrate, test, and maintain the solution around your existing process.</span></a>
        <a href="/services/security-deposit-automation/"><strong>Deposit evidence and approvals need a connected process</strong><span>Build the case intake, evidence collection, review gates, and disposition handoffs.</span></a>
        <a href="/services/missed-call-recovery/">
          <strong>Renters call and do not get a fast next step</strong>
          <span>Install missed-call text-back, qualification, CRM logging, and staff escalation.</span>
        </a>
        <a href="/services/leasing-follow-up/">
          <strong>Leads stall after inquiry, tour, or application</strong>
          <span>Install stage-aware follow-up with stop rules and CRM task updates.</span>
        </a>
        <a href="/services/maintenance-intake-automation/">
          <strong>Maintenance requests arrive without enough context</strong>
          <span>Collect urgency, access notes, photos, and routing details before dispatch.</span>
        </a>
        <a href="/services/crm-workflow-automation/">
          <strong>The CRM does not show the real next step</strong>
          <span>Clean up stages, tasks, notes, duplicate handling, and writebacks.</span>
        </a>
        <a href="/services/owner-update-automation/">
          <strong>Owners ask for the same status updates</strong>
          <span>Draft proactive owner updates with review gates and logging.</span>
        </a>
        <a href="/services/vendor-dispatch-automation/">
          <strong>Vendor coordination takes too many manual loops</strong>
          <span>Route qualified requests with approvals, reminders, and status updates.</span>
        </a>
      </div>
    </section>

    <section class="wrap service-grid-section">
      <p class="eyebrow">Service menu</p>
      <h2>What EMC2Ops builds and maintains</h2>
      <div class="service-grid">
        {
          servicePages.map((service) => (
            <article class="service-card">
              <span>{service.eyebrow}</span>
              <h2><a href={serviceUrl(service)}>{service.title}</a></h2>
              <p><strong>Deliverables:</strong> {deliverables[service.slug] || service.auditFocus}</p>
              <a class="read-more" href={serviceUrl(service)}>Explore {service.eyebrow.toLowerCase()}</a>
              <a class="read-more muted-more" href={auditHref(service.slug, "service")}>{service.auditCta.label}</a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap detail-section">
      <h2>Popular use cases</h2>
      <div class="related-links">
        <a href="/use-cases/apartment-lead-tracking/">
          <strong>Apartment lead tracking</strong>
          <span>Lead source, qualification, ownership, and CRM next steps</span>
        </a>
        <a href="/use-cases/lead-to-lease-automation/">
          <strong>Lead-to-lease automation</strong>
          <span>Inquiry, tour, application, approval, and move-in handoff</span>
        </a>
        <a href="/use-cases/how-to-automate-property-management/">
          <strong>How to automate property management</strong>
          <span>Start with one measurable workflow and expand from there</span>
        </a>
        <a href="/use-cases/real-estate-crm-follow-up-mess/">
          <strong>CRM follow-up cleanup</strong>
          <span>Fix stages, notes, tasks, duplicates, and ownership rules</span>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
