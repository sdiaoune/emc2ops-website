---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ClientReviews from "../../components/ClientReviews.astro";
import ProductScreenshot from "../../components/ProductScreenshot.astro";
import { auditHref } from "../../lib/conversion";
import { absoluteUrl, defaultSocialImage, standardPageSchema } from "../../lib/site";
import { integrationPages, integrationUrl } from "../../lib/integrations";
import { productScreenshotForPath } from "../../lib/productScreenshots";
import "../../styles/service.css";

const title = "Property Management Automation Integrations | EMC2Ops";
const description =
  "Compare API, middleware, and reviewed handoffs for AppFolio, Buildium, and LeadSimple, with workflow examples and the account access to verify.";
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/integrations/")}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="EMC2Ops property management automation integrations."
  schema={standardPageSchema({ path: "/integrations/", name: "Property management automation integrations", description, type: "CollectionPage" })}
  pageClass="service-page"
>
  <SiteHeader />
  <main>
    <section class="service-hero">
      <div class="wrap">
        <p class="eyebrow">Integrations</p>
        <h1>Automation workflows for the systems property teams already use.</h1>
        <p class="dek">
          Integration work is not always a direct API write. EMC2Ops scopes the safest route for
          each workflow: API, middleware, inbox parsing, structured forms, review queues, or a
          hybrid handoff.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/book-demo/#workflow=buildium&source=integrations-index">Book my integration audit</a>
          <a class="btn btn-secondary" href="#paths">Compare connection paths</a>
        </div>
      </div>
    </section>

    <section class="product-proof-section">
      <div class="wrap">
        <ProductScreenshot screenshot={productScreenshotForPath("/integrations/")} />
      </div>
    </section>

    <ClientReviews />

    <section id="paths" class="wrap detail-section">
      <p class="eyebrow">Connection paths</p>
      <h2>Choose the route that matches the workflow and access</h2>
      <div class="decision-grid">
        <a href="/integrations/buildium/">
          <strong>API or Open API</strong>
          <span>Use direct access when permissions, endpoint coverage, and workflow risk support it.</span>
        </a>
        <a href="/integrations/appfolio/">
          <strong>Middleware and webhooks</strong>
          <span>Connect surrounding tools through Zapier, Make, n8n, webhooks, or custom logic where supported.</span>
        </a>
        <a href="/services/maintenance-intake-automation/">
          <strong>Inbox or form parsing</strong>
          <span>Capture missing context when the system can receive cleaner summaries but direct access is limited.</span>
        </a>
        <a href="/services/owner-update-automation/">
          <strong>Human review queues</strong>
          <span>Hold owner-facing, financial, approval, or policy-sensitive steps before sending or writing updates.</span>
        </a>
      </div>
    </section>

    <section class="wrap detail-section" aria-labelledby="connection-evidence-heading">
      <h2 id="connection-evidence-heading">What each connection route needs</h2>
      <div class="installable-grid">
        <article class="installable-card"><h3>Direct API</h3><p>The exact read or write operation must exist and your account must permit it. Confirm field mapping, identity matching, response handling, and the saved destination record. A platform name alone does not establish access.</p></article>
        <article class="installable-card"><h3>Middleware or webhook</h3><p>A supported event can connect tools through automation logic. Verify the sending event and receiving action separately; retries, duplicates, and denied operations need owned handling. Middleware does not grant additional PMS permissions.</p></article>
        <article class="installable-card"><h3>Structured staff handoff</h3><p>An approved form, export, inbox record, or task can carry the source facts when direct access is unavailable. Name the person who performs the final update and require completion evidence.</p></article>
      </div>
      <h2>Review the platform-specific examples</h2>
      <div class="related-links">
        <a href="/integrations/buildium/"><strong>Buildium maintenance field mapping</strong><span>Property/unit matching, request context, staff ownership, and the operations to verify against Open API access.</span></a>
        <a href="/integrations/appfolio/"><strong>AppFolio API, Stack, and reviewed handoffs</strong><span>Compare authorized integration access with surrounding-tool automation and staff-reviewed alternatives.</span></a>
        <a href="/integrations/leadsimple/"><strong>LeadSimple owner-inquiry handoff</strong><span>Map source, pipeline, owner, and next task; confirm REST API access or a supported import/manual route.</span></a>
      </div>
      <p>Each example links to vendor documentation. Examples describe scope to verify; they do not imply a platform partnership or guaranteed access to your account.</p>
    </section>

    <section class="wrap service-grid-section">
      <p class="eyebrow">Integration menu</p>
      <h2>Systems and workflow handoffs</h2>
      <div class="service-grid">
        {
          integrationPages.map((integration) => (
            <article class="service-card">
              <img src={integration.logo} alt={`${integration.name} logo`} width="42" height="42" loading="lazy" />
              <span>{integration.name}</span>
              <h2><a href={integrationUrl(integration)}>{integration.title}</a></h2>
              <p>{integration.auditFocus}</p>
              <a class="read-more" href={integrationUrl(integration)}>View integration</a>
              <a class="read-more muted-more" href={auditHref(integration.slug, "integration")}>{integration.auditCta.label}</a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
