---
import { estimatedHoursSaved, estimatedMinutesPerOrder, estimatedMinutesSaved, study } from "../data/maintenanceWorkOrders";
---
<section class="estimate-band" aria-labelledby="estimate-heading" id="time-saved">
  <div class="wrap estimate-layout">
    <div>
      <h2 id="estimate-heading">Time saved on coordination</h2>
      <p>Office staff can check an assignment, read a technician’s notes, and prepare an invoice from the same record. For this work, we estimate a fixed {estimatedMinutesPerOrder} minutes saved per work order.</p>
    </div>
    <div class="estimate-panel">
      <p class="estimate-total"><strong>{estimatedHoursSaved} hours</strong></p>
      <p>Estimated administrative time saved</p>
      <p class="formula">{study.orders} work orders × {estimatedMinutesPerOrder} minutes = {estimatedMinutesSaved.toLocaleString("en-US")} minutes</p>
    </div>
  </div>
</section>
